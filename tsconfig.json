{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,

    "moduleResolution": "node",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",

    "baseUrl": "./src",

    "paths": {
      /* CORE */
      "@core/*": ["app/core/*"],
      "@core/services/*": ["app/core/services/*"],
      "@core/helpers/*": ["app/core/helpers/*"],
      "@core/guards/*": ["app/core/guards/*"],
      "@core/interceptors/*": ["app/core/interceptors/*"],

      /* SHARED */
      "@shared/*": ["app/shared/*"],
      "@shared/ui/*": ["app/shared/ui/*"],
      "@shared/services/*": ["app/shared/services/*"],
      "@shared/pipes/*": ["app/shared/pipes/*"],
      "@shared/directives/*": ["app/shared/directives/*"],
      "@shared/constants/*": ["app/shared/constants/*"],

      /* FEATURES */
      "@features/*": ["app/features/*"],

      /* TYPES */
      "@types/*": ["app/types/*"],
      "@interfaces/*": ["app/types/interfaces/*"],

      /* CONFIG */
      "@config/*": ["app/config/*"],

      /* HELPERS */
      "@helpers/*": ["app/helpers/*"],

      /* ENV */
      "@env/*": ["environments/*"],

      /* ASSETS */
      "@assets/*": ["public/*"],

      /* LEGACY (backward compatibility) */
      "@components/*": ["app/shared/ui/*"],
      "@services/*": ["app/shared/services/*"],
      "@pages/*": ["app/features/*"],
      "@data/*": ["app/types/*"],
      "@data/interfaces/*": ["app/types/interfaces/*"],
      "@data/types/*": ["app/types/*"],
      "src/app/types/*": ["app/types/*"],
      "src/app/pipes/*": ["app/shared/pipes/*"],
      "src/app/constants/*": ["app/shared/constants/*"],
      "../types/*": ["app/types/*"]
    }
  },

  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
